# Modelo local: copie para .env e preencha com seus próprios valores.
# Nunca inclua este arquivo nem o .env preenchido no versionamento.
# Use sempre uma base de desenvolvimento separada, nunca a base de produção.

# Conexão com o banco de dados (MySQL)
DATABASE_URL=mysql+pymysql://USUARIO:SENHA@127.0.0.1:3306/NOME_DO_BANCO

# Segurança — gere valores únicos para cada ambiente (veja o README)
JWT_SECRET_KEY=CHAVE_JWT_COM_PELO_MENOS_32_CARACTERES
CPF_ENCRYPTION_KEY=CHAVE_FERNET_VALIDA_PARA_CPF_TELEFONE

# Expiração do token de acesso (minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Ambiente da aplicação: "development" (padrão) ou "production"
APP_ENV=development

# Origens permitidas pelo CORS, separadas por vírgula.
# Em produção, defina APP_ENV=production e liste apenas as origens confiáveis.
CORS_ORIGINS=http://app.fluxocaixa,http://app.fluxocaixa:5173,http://127.0.0.1:5173
