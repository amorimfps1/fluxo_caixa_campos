# Modelo local: copie para .env e preencha com seus próprios valores.
# Nunca inclua o arquivo .env preenchido no versionamento.
# Use sempre uma base de desenvolvimento separada, nunca a base de produção.

# Conexão com o banco de dados:
# Local (MySQL 8.x):
# DATABASE_URL=mysql+pymysql://USUARIO:SENHA@127.0.0.1:3306/fluxo_caixa
# Produção (TiDB Cloud Serverless com SSL automático):
# DATABASE_URL=mysql+pymysql://USUARIO:SENHA@gateway01.ap-northeast-1.prod.aws.tidbcloud.com:4000/test
# Supabase / PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres.SEU_PROJETO:Flamengo200520082019@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_URL=postgres://USUARIO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Segurança — gere valores únicos para cada ambiente (veja o README.md)
JWT_SECRET_KEY=CHAVE_JWT_COM_PELO_MENOS_32_CARACTERES
CPF_ENCRYPTION_KEY=CHAVE_FERNET_VALIDA_PARA_CPF_TELEFONE

# Expiração do token de acesso (minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Ambiente da aplicação: "development" (padrão) ou "production"
APP_ENV=development

# Origens permitidas pelo CORS, separadas por vírgula.
# Em produção (APP_ENV=production), liste apenas as origens confiáveis (ex.: https://fluxo-caixa-coral-two.vercel.app).
CORS_ORIGINS=http://app.fluxocaixa,http://app.fluxocaixa:5173,http://127.0.0.1:5173,http://127.0.0.1:5500

# Envio de e-mails transacionais (SMTP) — confirmação de cadastro e OTP de recuperação de senha
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
